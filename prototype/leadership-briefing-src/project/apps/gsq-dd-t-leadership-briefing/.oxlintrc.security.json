{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**"
  ],
  "plugins": ["react"],
  "rules": {
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-danger": "error",
    "react/no-danger-with-children": "error"
  },
  "env": {
    "browser": true
  }
}
